# Supabase DO NAS DE CASA — carregado pelo Vite só em `--mode nas` (deploy-nas.sh),
# por cima do app/.env (que aponta pro projeto cloud). Anon key é pública por
# desenho (igual à do .env); a de verdade vem do init do Supabase no NAS.
VITE_SUPABASE_URL=https://supabase.nas.local
VITE_SUPABASE_ANON_KEY=__PREENCHIDO_PELO_INIT_DO_NAS__
